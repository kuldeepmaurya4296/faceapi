# ---------------------------------------------------------------------------
# Face API configuration. Copy to `.env` and edit. Every value can also be
# passed as a normal environment variable (Docker, systemd, Kubernetes).
# ---------------------------------------------------------------------------

# --- service identity ------------------------------------------------------
FACEAPI_SERVICE_NAME=Face API
FACEAPI_PUBLIC_BASE_URL=https://api.yourdomain.com
FACEAPI_DOCS_ENABLED=true
FACEAPI_LOG_LEVEL=INFO

# --- authentication --------------------------------------------------------
# true  = commercial mode: every /v1/* call needs an X-API-Key header.
# false = personal mode: no key at all, unlimited use (for your own projects).
FACEAPI_AUTH_ENABLED=true

# Protects every /admin/* endpoint. Generate with: openssl rand -base64 32
# If you leave it empty, one is generated into <data_dir>/admin_token.txt.
FACEAPI_ADMIN_TOKEN=

# --- storage ---------------------------------------------------------------
FACEAPI_DATA_DIR=./data
FACEAPI_MODELS_DIR=./models
FACEAPI_DB_FILENAME=faceapi.db

# --- detection tuning ------------------------------------------------------
# Images larger than this are downscaled before detection (longest side).
FACEAPI_MAX_IMAGE_SIDE=1600
FACEAPI_MAX_UPLOAD_MB=10
FACEAPI_DETECT_SCORE_THRESHOLD=0.85
FACEAPI_DETECT_NMS_THRESHOLD=0.30
FACEAPI_MIN_FACE_SIZE=16

# --- recognition tuning ----------------------------------------------------
# 0.363 is OpenCV's recommended cosine threshold for SFace.
FACEAPI_VERIFY_THRESHOLD=0.363
FACEAPI_IDENTIFY_THRESHOLD=0.363
FACEAPI_IDENTIFY_MAX_CANDIDATES=5

# --- API behaviour ---------------------------------------------------------
FACEAPI_DEFAULT_MAX_FACES=20
FACEAPI_CORS_ORIGINS=*
FACEAPI_TRUST_PROXY_HEADERS=false

# --- models ----------------------------------------------------------------
FACEAPI_DETECT_MODEL=face_detection_yunet_2023mar.onnx
FACEAPI_RECOG_MODEL=face_recognition_sface_2021dec.onnx

# ---------------------------------------------------------------------------
# Docker-only knobs (read by docker-entrypoint.sh)
# ---------------------------------------------------------------------------
PORT=8000
WORKERS=2
